<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextureView
            android:id="@+id/preview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- 보조 화각(초광각/망원) 프리뷰. 동시 촬영이 켜질 때만 보인다. -->
        <TextureView
            android:id="@+id/previewAux"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:text="준비" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:text="주사율(Hz)" />

        <EditText
            android:id="@+id/editRefresh"
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:text="60" />

        <CheckBox
            android:id="@+id/chkTri"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:textSize="13sp"
            android:text="멀티 카메라 동시 교차(초광각/표준/망원 중 2~3대)" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#22000000">

        <TextView
            android:id="@+id/txtResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textSize="13sp"
            android:typeface="monospace"
            android:text="측정을 시작하면 진행 상황이 표시됩니다." />
    </ScrollView>

    <!-- 3위치 비네팅 보정: 탭을 프레임 위·아래·가운데에 두고 차례로 확정한다. 측정 화면에서만 보인다. -->
    <LinearLayout
        android:id="@+id/rowVignette"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnVignette"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="비네팅 보정 (3위치)" />

        <TextView
            android:id="@+id/txtVignette"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:textSize="12sp"
            android:text="비네팅 보정값 없음" />
    </LinearLayout>

    <!-- 최대 감쇠(%) 입력과 감쇠 필요도 검증. 측정 화면에서만 보인다. -->
    <LinearLayout
        android:id="@+id/rowAttenuation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:text="최대 감쇠(%)" />

        <EditText
            android:id="@+id/editMaxAtt"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLines="1"
            android:text="10" />

        <Button
            android:id="@+id/btnCheckAtt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="감쇠 필요도 검증" />

        <!-- 색(채널 비) 보정: 번인 측정과 따로, 밝기 보정맵을 켠 위에서 -->
        <Button
            android:id="@+id/btnColor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="색 보정" />
    </LinearLayout>

    <!-- 측정 뒤, 그 측정의 최적 맵에서 반복 보정을 n회 더 돌린다. 측정 화면에서만 보인다. -->
    <LinearLayout
        android:id="@+id/rowExtra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:text="추가 개선 시도 횟수" />

        <EditText
            android:id="@+id/editExtra"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLines="1"
            android:text="4" />

        <Button
            android:id="@+id/btnExtra"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="추가 개선 4회" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="측정 시작" />

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="보정 전/후 토글" />
    </LinearLayout>
</LinearLayout>
